DATABASE_URL=postgresql://chatpan:chatpan_local@127.0.0.1:5432/chatpan
APP_URL=http://localhost:3000
# Generate locally: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=
XINGCHI_BASE_URL=https://api.xingchiapi.com/v1
XINGCHI_API_KEY=
DEFAULT_CHAT_MODEL=gpt-6.1-sol
# Responses is the default. Explicitly map legacy models to Chat Completions when needed.
XINGCHI_WIRE_API=responses
XINGCHI_MODEL_WIRE_API={}
DEFAULT_IMAGE_MODEL=
# Optional email delivery; registration remains unverified until email is delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: install Tesseract on the server. Not available in standard Vercel functions.
OCR_ENABLED=false
OCR_LANG=eng
