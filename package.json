{
  "name": "chatpan",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "npm run db:generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/migrate.mjs",
    "db:generate": "node scripts/generate.mjs",
    "test:provider:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "bcryptjs": "^3.0.2",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "framer-motion": "^14.14.0",
    "iron-session": "^9.1.0",
    "jose": "^6.0.0",
    "katex": "^0.19.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "next": "16.4.6",
    "nodemailer": "^10.5.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@prisma/client-generator-js": "^7.10.1",
    "@prisma/driver-adapter-utils": "^7.10.1",
    "@prisma/internals": "^7.10.1",
    "@prisma/schema-engine-wasm": "^8.1.0-1.d1b3f377ca835d73fd50954a5e22128b9ebdd6b8",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "katex": "$katex",
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
